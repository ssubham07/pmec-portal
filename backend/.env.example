PORT=5000

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=pmec_portal
PGUSER=postgres
PGPASSWORD=postgres

# Email domain gate
STUDENT_EMAIL_DOMAIN=@pmec.ac.in

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# SMTP (placeholder - use mailtrap/gmail app-password/etc. in real deployment)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@pmec.edu
SMTP_PASS=changeme
SMTP_FROM="PMEC Service Portal <no-reply@pmec.edu>"

# File storage
UPLOAD_DIR=uploads

# Frontend origin (for CORS)
CLIENT_ORIGIN=http://localhost:3000
